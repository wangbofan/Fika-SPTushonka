<Project>

	<!-- csharp version -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!-- use author info from AssemblyInfo.cs -->
	<PropertyGroup>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../Properties/AssemblyInfo.cs" />
	</ItemGroup>

	<!-- 路径统一由仓库根的 Directory.Build.props 提供（GameRoot / BepInExCore / Interop / SptPlugins / FikaPlugins）。
	     上游这里写死了 D:/SPT-5.0.0/DEV，会覆盖根配置，导致 clone 后编译找不到 EFT/Comfort 等程序集。 -->

</Project>
