<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Build.props" />

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<!-- targets -->
	<PropertyGroup>
		<Configurations>Debug;Release;GoldMaster</Configurations>
		<DefineConstants Condition="'$(Configuration)' == 'GoldMaster|AnyCPU' ">TRACE;GOLDMASTER</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='GoldMaster'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<Optimize>true</Optimize>
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Bundles\Files\masterbundle.bundle" />
		<None Remove="Bundles\Files\masterbundle.bundle" />
	</ItemGroup>

	<!-- 移植改动：原工程用 PackageReference BepInEx.Core 5.* + UnityEngine.Modules 2022.3.43
	     + References\spt-*.dll(4.1.3) + References\hollowed.dll。
	     这里全部替换为本机 SPTushonka 5.0 / BepInXDX 6(BepInEx 6) / IL2CPP interop 程序集。 -->
	<ItemGroup>
		<Reference Include="$(BepInExCore)/BepInEx.Core.dll" Private="false" />
		<Reference Include="$(BepInExCore)/BepInEx.Unity.IL2CPP.dll" Private="false" />
		<Reference Include="$(BepInExCore)/BepInEx.Unity.Common.dll" Private="false" />
		<Reference Include="$(BepInExCore)/0Harmony.dll" Private="false" />
		<Reference Include="$(BepInExCore)/SemanticVersioning.dll" Private="false" />
		<Reference Include="$(BepInExCore)/Il2CppInterop.Common.dll" Private="false" />
		<Reference Include="$(BepInExCore)/Il2CppInterop.Runtime.dll" Private="false" />
		<Reference Include="$(BepInExCore)/Il2CppInterop.HarmonySupport.dll" Private="false" />
		<Reference Include="$(Interop)/*.dll" Exclude="$(Interop)/__Generated.dll" Private="false" />
		<Reference Include="$(SptPlugins)/SPTushonka.*.dll" Private="false" />
	</ItemGroup>

</Project>
